{
  "name": "@tedbyron/website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "proseWrap": "always",
    "plugins": [
      "prettier-plugin-svelte",
      "prettier-plugin-tailwindcss"
    ],
    "overrides": [
      {
        "files": "*.svelte",
        "options": {
          "parser": "svelte"
        }
      }
    ],
    "tailwindStylesheet": "./src/app.css"
  },
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . \"!package-lock.json\" && eslint .",
    "format": "prettier --write . \"!package-lock.json\""
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.9",
    "@iconify-json/tabler": "^1.2.17",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/enhanced-img": "^1.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.17",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-svelte": "^3.23.1",
    "mdsvex": "^0.12.6",
    "prettier": "^3.5.3",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-github": "^12.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "typescript-svelte-plugin": "^0.3.52",
    "unplugin-icons": "^22.1.0",
    "vite": "^8.3.5",
    "wrangler": "^4.155.0"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*",
    "#components/*": "./src/lib/components/*"
  }
}
