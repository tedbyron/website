{
  inputs = {
    nixpkgs.url = "nixpkgs/nixpkgs-unstable";
    flake-utils.url = "flake-utils";
    curlio = {
      url = "github:tedbyron/dotfiles?dir=flakes/curlio";
      inputs.nixpkgs.follows = "nixpkgs";
      inputs.flake-utils.follows = "flake-utils";
    };
  };

  outputs =
    {
      nixpkgs,
      flake-utils,
      curlio,
      ...
    }:
    flake-utils.lib.eachDefaultSystem (
      system:
      let
        pkgs = import nixpkgs { inherit system; };
        nodeMajor =
          ./.node-version
          |> builtins.readFile
          |> pkgs.lib.trim
          |> pkgs.lib.removePrefix "v"
          |> pkgs.lib.versions.major;
        curlioFonts = curlio.packages.${system}.all-web-latin;
      in
      with pkgs;
      {
        formatter = nixfmt;

        # Copy Curlio's WOFF2s into the repo and write a @font-face for each.
        apps.update-fonts = flake-utils.lib.mkApp {
          drv = writeShellApplication {
            name = "update-fonts";
            runtimeInputs = [
              coreutils
              git
            ];
            text = ''
              fonts="$(git rev-parse --show-toplevel)/src/lib/assets/fonts"
              rm -f "$fonts"/*.woff2
              install -m644 ${curlioFonts}/share/fonts/woff2/*.woff2 "$fonts"

              {
                echo "/* Generated by \`nix run .#update-fonts\` from the dotfiles curlio flake. */"
                for file in "$fonts"/*.woff2; do
                  name=$(basename "$file" .woff2)
                  rest=''${name#Iosevkacurlio-}

                  case $rest in
                    normal*) stretch=normal ;;
                    condensed*) stretch=condensed ;;
                    *) echo "unknown width: $name" >&2; exit 1 ;;
                  esac
                  rest=''${rest#"$stretch"}

                  style=normal
                  case $rest in
                    *Italic) style=italic rest=''${rest%Italic} ;;
                    *Oblique) style=oblique rest=''${rest%Oblique} ;;
                  esac

                  case $rest in
                    Thin) weight=100 ;;
                    ExtraLight) weight=200 ;;
                    Light) weight=300 ;;
                    "") weight=400 ;;
                    Medium) weight=500 ;;
                    SemiBold) weight=600 ;;
                    Bold) weight=700 ;;
                    ExtraBold) weight=800 ;;
                    Heavy) weight=900 ;;
                    *) echo "unknown weight: $name" >&2; exit 1 ;;
                  esac

                  printf "\n@font-face {\n  font-family: 'Curlio';\n  font-display: swap;\n  font-stretch: %s;\n  font-style: %s;\n  font-weight: %s;\n  src: url('./%s.woff2') format('woff2');\n}\n" \
                    "$stretch" "$style" "$weight" "$name"
                done
              } > "$fonts/fonts.css"
            '';
          };
        };

        devShells.default = mkShellNoCC {
          packages = [ pkgs."nodejs_${nodeMajor}" ];
        };
      }
    );
}
